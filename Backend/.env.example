# Copy this file to .env and fill in your values.
# The .env file is loaded by docker-compose automatically.

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# See MONGODB_SETUP.md for step-by-step instructions.
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/app_store_analyzer

# Secret used to sign app-issued JWTs — use a long random string.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-secret

# Must match the bundle ID of your iOS app (set in Xcode / project.yml).
APPLE_BUNDLE_ID=com.ipronto.appstoreanalyzer

# Flask port (default 5001 — avoids conflict with macOS AirPlay Receiver on 5000)
PORT=5001

# DEV_MODE=true accepts a hardcoded simulator token so you can test on the iOS Simulator.
# NEVER set this to true in production.
DEV_MODE=false
